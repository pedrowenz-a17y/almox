# Copie para .env. Nunca versione credenciais reais.
# Prisma 6: URL de execução e conexão direta/session para migrations.
# Copie do painel Connect do Supabase. Não invente host, senha ou parâmetros.
DATABASE_URL=""
DIRECT_URL=""

# Origem pública exata sem caminho. Produção deve usar HTTPS.
APP_URL="http://localhost:3000"
# Opcional: origens adicionais completas, separadas por vírgula, sem curingas.
APP_ALLOWED_ORIGINS=""

# Supabase Auth: URL e chave publicável do seu projeto.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Exclusivamente no servidor; utilizada para convites/provisionamento.
SUPABASE_SERVICE_ROLE_KEY=""

# PostgreSQL local opcional. Docker Compose não fornece Supabase Auth.
POSTGRES_USER="almox"
POSTGRES_DB="almox"
POSTGRES_PASSWORD=""
POSTGRES_PORT="5432"
APP_BIND="127.0.0.1"
APP_PORT="3000"

# Testes isolados: nome da base deve conter test. Nunca usar produção.
# TEST_DATABASE_URL=""
# QA_BASE_URL="http://localhost:3000"
# QA_ENVIRONMENT="isolated"
# QA_UNIT_ID=""
# QA_LOCATION_ID=""
# QA_ADMIN_EMAIL=""
# QA_ADMIN_PASSWORD=""
# QA_OPERATOR_EMAIL=""
# QA_OPERATOR_PASSWORD=""
# QA_SUPERVISOR_EMAIL=""
# QA_SUPERVISOR_PASSWORD=""
# QA_ALLOWED_REMOTE_ORIGIN=""
# ALLOW_QA_WRITES="1"

# Provisionamento administrativo pontual. Identidade existente e confirmada no Supabase.
# PROVISION_AUTH_USER_ID=""
# PROVISION_ADMIN_EMAIL=""
# PROVISION_ADMIN_NAME=""
# PROVISION_UNIT_CODES="UCA,CAPACLE"
# Extensão de permissões preexistentes somente após revisão do responsável:
# BOOTSTRAP_EXTEND_ROLE_PERMISSIONS="true"

# Migração: variáveis usadas somente pelas ferramentas administrativas.
# MIGRATION_DATABASE_URL=""
# MIGRATION_APPLY_APPROVED="true"
# MIGRATION_APPROVER_USER_ID=""
