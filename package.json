{
  "name": "almox-erp",
  "version": "2.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:local": "node scripts/local-db.mjs",
    "verify:api": "node scripts/verify-api.mjs",
    "verify:browser": "node scripts/verify-browser.mjs",
    "verify:reports": "node scripts/verify-reports.mjs",
    "verify:operations": "node scripts/verify-operations.mjs",
    "config:check": "node scripts/check-config.mjs",
    "doctor": "node scripts/doctor.mjs",
    "admin:provision": "tsx scripts/provision-admin.ts",
    "migration:snapshot": "node scripts/migration-snapshot.mjs",
    "migration:compare": "node scripts/migration-compare.mjs",
    "migration:map": "node scripts/migration-map-units.mjs",
    "verify:public": "node scripts/verify-public.mjs",
    "verify:orders": "node scripts/verify-orders-ui.mjs",
    "verify:auth": "node scripts/verify-auth-flows.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "exceljs": "^4.4.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.468.0",
    "next": "^16.0.10",
    "qrcode": "^1.5.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.10",
    "prisma": "^6.19.1",
    "sharp": "^0.34.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "@emnapi/core": "1.10.0",
    "@emnapi/wasi-threads": "1.2.1"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
