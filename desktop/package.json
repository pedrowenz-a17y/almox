{
  "name": "almox-desktop",
  "productName": "Almox ERP",
  "version": "2.6.0",
  "description": "Almox ERP U.C.A. para Windows",
  "author": "Projeto Almox ERP",
  "repository": { "type": "git", "url": "https://github.com/pedrowenz-a17y/almox.git" },
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "prepare:server": "node scripts/prepare-server.cjs",
    "dist:win": "node scripts/package-windows.cjs",
    "pack:linux": "electron-builder --linux dir --x64"
  },
  "dependencies": { "dotenv": "16.6.1" },
  "devDependencies": { "electron": "45.2.3", "electron-builder": "26.18.0" },
  "build": {
    "appId": "br.uca.almox.desktop",
    "productName": "Almox ERP",
    "asar": true,
    "npmRebuild": false,
    "directories": { "output": "dist", "buildResources": "assets" },
    "files": ["*.cjs", "setup/**", "assets/**", "package.json"],
    "extraResources": [
      { "from": "server", "to": "server", "filter": ["**/*", "!**/.env", "!**/.env.*"] },
      { "from": "server/node_modules", "to": "server/node_modules", "filter": ["**/*", "!**/.env", "!**/.env.*"] }
    ],
    "win": { "target": "nsis", "icon": "assets/icon.ico", "artifactName": "Almox-ERP-${version}-Windows-x64-Setup.${ext}" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Almox ERP",
      "installerLanguages": ["pt_BR"],
      "language": "1046",
      "deleteAppDataOnUninstall": false
    },
    "linux": { "icon": "assets/icon.png", "category": "Office" }
  }
}
